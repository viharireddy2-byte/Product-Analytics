<?xml version='1.0' encoding='utf-8'?>
<workbook source-platform="win" version="18.1">
  <preferences />
  <datasources>
    <datasource caption="Daily" inline="true" name="daily" version="18.1">
      <connection class="textscan" directory="data" filename="dashboard_daily.csv" password="" server="">
        <relation name="daily" table="[dashboard_daily#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="date" name="session_date" ordinal="0" />
            <column datatype="string" name="device_type" ordinal="1" />
            <column datatype="string" name="traffic_medium" ordinal="2" />
            <column datatype="integer" name="sessions" ordinal="3" />
            <column datatype="integer" name="product_views" ordinal="4" />
            <column datatype="integer" name="carts" ordinal="5" />
            <column datatype="integer" name="purchases" ordinal="6" />
            <column datatype="integer" name="unordered_purchases" ordinal="7" />
            <column datatype="datetime" name="published_at" ordinal="8" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column caption="Session Date" datatype="date" name="[session_date]" role="dimension" type="ordinal" />
      <column caption="Device Type" datatype="string" name="[device_type]" role="dimension" type="nominal" />
      <column caption="Traffic Medium" datatype="string" name="[traffic_medium]" role="dimension" type="nominal" />
      <column caption="Sessions" datatype="integer" name="[sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Product Views" datatype="integer" name="[product_views]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Carts" datatype="integer" name="[carts]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Purchases" datatype="integer" name="[purchases]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Unordered Purchases" datatype="integer" name="[unordered_purchases]" role="measure" type="quantitative" />
      <column caption="Published At" datatype="datetime" name="[published_at]" role="dimension" type="ordinal" />
      <column caption="Conversion Rate" datatype="real" default-format="p0.00%" name="[conversion_rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([sessions]) &gt; 0 THEN SUM([purchases]) / SUM([sessions]) END" />
      </column>
    </datasource>
    <datasource caption="Funnel" inline="true" name="funnel" version="18.1">
      <connection class="textscan" directory="data" filename="funnel.csv" password="" server="">
        <relation name="funnel" table="[funnel#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="integer" name="ordinal" ordinal="0" />
            <column datatype="string" name="stage" ordinal="1" />
            <column datatype="integer" name="sessions" ordinal="2" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column caption="Ordinal" datatype="integer" name="[ordinal]" role="dimension" type="ordinal" />
      <column caption="Stage" datatype="string" name="[stage]" role="dimension" type="nominal" />
      <column caption="Sessions" datatype="integer" name="[sessions]" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="Retention" inline="true" name="retention" version="18.1">
      <connection class="textscan" directory="data" filename="retention.csv" password="" server="">
        <relation name="retention" table="[retention#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="integer" name="month_number" ordinal="0" />
            <column datatype="integer" name="active_users" ordinal="1" />
            <column datatype="integer" name="cohort_size" ordinal="2" />
            <column datatype="real" name="retention_rate" ordinal="3" />
            <column datatype="boolean" name="is_partial_month" ordinal="4" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column caption="Month Number" datatype="integer" name="[month_number]" role="dimension" type="ordinal" />
      <column caption="Active Users" datatype="integer" name="[active_users]" role="measure" type="quantitative" />
      <column caption="Cohort Size" datatype="integer" name="[cohort_size]" role="measure" type="quantitative" />
      <column caption="Retention Rate" datatype="real" name="[retention_rate]" role="measure" type="quantitative" default-format="p0.00%" />
      <column caption="Is Partial Month" datatype="boolean" name="[is_partial_month]" role="dimension" type="nominal" />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Sessions — full sample">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontname="Arial" fontsize="12">Sessions — full sample</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Daily" name="daily" />
          </datasources>
          <datasource-dependencies datasource="daily">
            <column caption="Sessions" datatype="integer" name="[sessions]" role="measure" type="quantitative" default-format="n#,##0" />
            <column-instance column="[sessions]" derivation="Sum" name="[sum:sessions:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[daily].[sum:sessions:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid="{84df12f4-2d64-569a-b834-cd68d8907f01}" />
    </worksheet>
